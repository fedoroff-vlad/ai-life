<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.fedorov.ailife</groupId>
        <artifactId>ai-life-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>finance-aux-host</artifactId>
    <name>ai-life :: deploy :: finance-aux-host</name>
    <description>
        ADR-0006 / #584 slice 3j: the fifth cold host-unit — the Finance-aux unit (two aux capability-MCPs
        mcp-market-data/mcp-chart-render + two import domain-MCPs mcp-money-pro-import/mcp-ics-import) booted
        as ONE JVM. The first MCP-only cold unit (no agent): grouped by co-usage affinity (topology-map
        §Grouping 1), these seldom-used finance/calendar helpers start/stop together, reclaiming the
        per-process JVM baseline for the whole cluster (4 JVMs → 1). Path B (process consolidation),
        approach B1 (multi-context, ports kept — zero contract change). Depends on each module's plain
        classes jar (enabled by the #584 3j exec-classifier).
    </description>

    <dependencies>
        <!-- The Finance-aux cold host-unit (topology-map.md §Cold). Each module's MAIN artifact is a plain
             classes jar (the executable is the -exec classifier, #584 3j), so this host depends on them
             normally and boots each as its own context on its own port. -->
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>mcp-market-data</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>mcp-chart-render</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>mcp-money-pro-import</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>mcp-ics-import</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Testcontainers PG base (AbstractPostgresIntegrationTest) + JDBC: mcp-money-pro-import and
             mcp-ics-import are DB-bound, so the shared PG is wired to every context so they can boot
             (ddl-auto=none — no schema needed to start the web + MCP servers). The two capability-MCPs
             (mcp-market-data, mcp-chart-render) are schema-less; the datasource is harmless for them. -->
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
