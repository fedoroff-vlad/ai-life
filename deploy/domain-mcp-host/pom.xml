<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.fedorov.ailife</groupId>
        <artifactId>ai-life-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>domain-mcp-host</artifactId>
    <name>ai-life :: deploy :: domain-mcp-host</name>
    <description>
        ADR-0006 / #584 slice 3c: the resident Domain-MCP-hot host — a single JVM that boots the
        always-on MCP contexts (mcp-caldav, mcp-finance, mcp-tasks, mcp-web, mcp-media-processing)
        side-by-side (each on its own port, its own MCP server — zero contract change), reclaiming the
        per-process JVM baseline once per host. Path B (process consolidation), approach B1 (multi-context,
        ports kept). Depends on each module's plain classes jar (enabled by the #584 3a exec-classifier).
    </description>

    <dependencies>
        <!-- The resident Domain-MCP-hot set (topology-map.md §Resident). Each module's MAIN artifact is
             a plain classes jar (the executable is the -exec classifier, #584 3a), so this host depends
             on them normally and boots each as its own context, on its own port, with its own MCP server. -->
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>mcp-caldav</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>mcp-finance</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>mcp-tasks</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>mcp-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>mcp-media-processing</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>test-support</artifactId>
        </dependency>
    </dependencies>
</project>
