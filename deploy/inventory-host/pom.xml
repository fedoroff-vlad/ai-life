<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.fedorov.ailife</groupId>
        <artifactId>ai-life-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>inventory-host</artifactId>
    <name>ai-life :: deploy :: inventory-host</name>
    <description>
        ADR-0006 / #584 slice 3k: the sixth cold host-unit — the Inventory unit (inventory-agent +
        mcp-inventory) booted as ONE JVM. The Inventory domain shipped (2026-09-27) after the topology map
        was drawn, so it was the one domain with no host at all; it takes the Docs shape (3f) — a single
        agent plus its own domain-MCP, grouped by co-usage affinity and started/stopped as a unit. Path B
        (process consolidation), approach B1 (multi-context, ports kept — zero contract change). Depends on
        each module's plain classes jar (the #584 3a exec-classifier, which both modules already carry —
        they were built after the enabler landed).
    </description>

    <dependencies>
        <!-- The Inventory cold host-unit (topology-map.md §Cold). Each module's MAIN artifact is a plain
             classes jar (the executable is the -exec classifier, #584 3a), so this host depends on them
             normally and boots each as its own context on its own port. -->
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>inventory-agent</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>mcp-inventory</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Testcontainers PG base (AbstractPostgresIntegrationTest) + JDBC: mcp-inventory is DB-bound, so
             the shared PG is wired to every context so it can boot (ddl-auto=none — no schema needed to
             start the web + MCP servers). inventory-agent owns no schema; its MCP client is disabled in the
             IT (co-residency proof, not the agent→MCP SSE wiring, which lands at deploy). -->
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
