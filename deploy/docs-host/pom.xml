<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.fedorov.ailife</groupId>
        <artifactId>ai-life-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>docs-host</artifactId>
    <name>ai-life :: deploy :: docs-host</name>
    <description>
        ADR-0006 / #584 slice 3f: the first cold host-unit — the Docs unit (docs-agent + mcp-docs) booted
        as ONE JVM. Cold hosts group by co-usage affinity (topology-map §Grouping 1), so unlike the
        resident tier this host deliberately MIXES the agent tier and its domain-MCP in one process:
        started/stopped as a unit, it reclaims the per-process JVM baseline for a whole cold cluster at
        once. Path B (process consolidation), approach B1 (multi-context, ports kept — zero contract
        change). Depends on each module's plain classes jar (enabled by the #584 3f exec-classifier).
    </description>

    <dependencies>
        <!-- The Docs cold host-unit (topology-map.md §Cold). Each module's MAIN artifact is a plain
             classes jar (the executable is the -exec classifier, #584 3f), so this host depends on them
             normally and boots each as its own context on its own port. -->
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>docs-agent</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>mcp-docs</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Testcontainers PG base (AbstractPostgresIntegrationTest) + JDBC: mcp-docs is DB-bound, so the
             shared PG is wired to every context so it can boot (ddl-auto=none — no schema needed to start
             the web + MCP servers). docs-agent owns no schema; its MCP client is disabled in the IT
             (co-residency proof, not the agent→MCP SSE wiring, which lands at deploy). -->
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
