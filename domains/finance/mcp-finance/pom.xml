<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.fedorov.ailife</groupId>
        <artifactId>ai-life-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>mcp-finance</artifactId>
    <name>ai-life :: mcp :: finance</name>
    <description>MCP server: CRUD + aggregates over finance.* schema (accounts, categories, transactions)</description>

    <dependencies>
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>platform-common</artifactId>
        </dependency>
        <!-- Event-bus producer: publishes basket.captured to bus.outbox (IA-a) so the
             nutrition domain can fan out off the same Postgres bus. -->
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>event-bus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- webmvc, not webflux: this module pulls spring-boot-starter-web for its /internal/*
             controllers, so it boots on the servlet stack, where the webflux MCP starter's
             reactive endpoints never mount (/sse → 404). See plans/PATTERNS.md §Recipe: add a
             new domain-MCP; enforced by check-consistency.sh check 17. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>test-support</artifactId>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webtestclient</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <resources>
            <!-- The default location, re-declared because the block below replaces the implicit one.
                 Keeps application.yml at classpath:/application.yml so the standalone -exec.jar is
                 unaffected by the co-hosting change. -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- ADR-0006 / #584 slice 3n: land a COPY of this module's own application.yml at a
                 per-module classpath path, so co-hosted contexts (Domain-MCP-hot host) each read their
                 OWN configuration instead of colliding on classpath:/application.yml. The host boots
                 each context with spring.config.location=classpath:/config/mcp-finance/.
                 One source file, two classpath locations — nothing to keep in sync by hand.
                 Same precedent as slice 3d's per-agent manifest/<name>/AGENT.md. -->
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>application.yml</include>
                </includes>
                <targetPath>config/mcp-finance</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- ADR-0006 / #584: attach the executable (Boot fat) jar under the `exec` classifier
                     so the module's MAIN artifact stays a plain classes jar that other reactor modules
                     (the consolidation host) can depend on. The Dockerfile runs `<artifact>-exec.jar`. -->
                <configuration>
                    <classifier>exec</classifier>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
