<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.fedorov.ailife</groupId>
        <artifactId>ai-life-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>mcp-web</artifactId>
    <name>ai-life :: mcp :: web</name>
    <description>Capability-MCP: web search + page fetch over a SearXNG backing service. No schema. Bound by any agent (researcher, chef, briefing, …).</description>

    <dependencies>
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.fedorov.ailife</groupId>
            <artifactId>platform-common</artifactId>
        </dependency>

        <!-- Reactive web only: the MCP server is webflux-based and WebClient calls the
             SearXNG backing service. No servlet stack, no JPA, no datasource
             (a capability-MCP owns no data). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webflux</artifactId>
        </dependency>

        <!-- fetch_url (R-b): jsoup fetches + parses HTML and extracts readable text.
             Behind the PageFetcher interface, so a heavier readability lib can replace it. -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webtestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webclient</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <resources>
            <!-- The default location, re-declared because the block below replaces the implicit one.
                 Keeps application.yml at classpath:/application.yml so the standalone -exec.jar is
                 unaffected by the co-hosting change. -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- ADR-0006 / #584 slice 3n: land a COPY of this module's own application.yml at a
                 per-module classpath path, so co-hosted contexts (Domain-MCP-hot host) each read their
                 OWN configuration instead of colliding on classpath:/application.yml. The host boots
                 each context with spring.config.location=classpath:/config/mcp-web/.
                 One source file, two classpath locations — nothing to keep in sync by hand.
                 Same precedent as slice 3d's per-agent manifest/<name>/AGENT.md. -->
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>application.yml</include>
                </includes>
                <targetPath>config/mcp-web</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- ADR-0006 / #584: attach the executable (Boot fat) jar under the `exec` classifier
                     so the module's MAIN artifact stays a plain classes jar that other reactor modules
                     (the consolidation host) can depend on. The Dockerfile runs `<artifact>-exec.jar`. -->
                <configuration>
                    <classifier>exec</classifier>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
